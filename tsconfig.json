{
  "compilerOptions": {
    "target": "es5",
    "lib" : [ "es2015", "dom" ],
    "module":"es6",
    "stripInternal": true,
    "declaration": true,
    "importHelpers": true,
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "sourceMap": true,
    "outDir": "./lib",
    "esModuleInterop": true,
    "strict": false,
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "noImplicitReturns": false,
    "removeComments":true,
    "experimentalDecorators": true
  }
}
