{
    "private": true,
    "packageManager": "yarn@4.9.4",
    "workspaces": [
        "mixture",
        "models",
        "ext-types",
        "globals",
        "endpoints",
        "react",
        "tests",
        "docs"
    ],
    "scripts": {
        "build": "yarn && yarn build:all && yarn test",
        "build:all": "yarn workspaces foreach --all --exclude . run build",
        "test": "yarn workspace @type-r/tests test"
    },
    "devDependencies": {
        "rimraf": "^2.6.3",
        "rollup": "*",
        "rollup-plugin-commonjs": "*",
        "rollup-plugin-node-resolve": "*",
        "rollup-plugin-paths": "*",
        "rollup-plugin-sourcemaps": "*",
        "rollup-plugin-uglify": "*",
        "typescript": "6.0.3"
    }
}
